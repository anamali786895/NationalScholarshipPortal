@model InstituteScholarshipPortal.Models.InstituteRegistration

@{
    ViewData["Title"] = "Institute Profile";
}

<link rel="stylesheet" href="~/css/custom.css" />

<div class="dashboard-container">

    <div class="sidebar">
        <h3 class="sidebar-title">NSP Portal</h3>
        <ul class="sidebar-menu">
            <li><a href="/Institute/Dashboard">Dashboard</a></li>
            <li><a href="/Institute/ViewProfile" class="active">View Profile</a></li>
            <li><a href="/Institute/EditProfile">Edit Profile</a></li>
            <li><a href="/Institute/Register">New Registration</a></li>
            <li><a href="/Institute/Logout" class="text-danger fw-bold">Logout</a></li>
        </ul>
    </div>


    <!-- MAIN CONTENT -->
    <div class="main-content">

        <div class="welcome-box shadow mb-4">
            <h2 class="fw-bold text-primary">Institute Profile</h2>
            <p class="text-muted">Below are your institute details.</p>
        </div>

        <div class="card p-4 shadow" style="border-radius: 12px;">

            <h4 class="text-secondary fw-bold mb-3">Basic Details</h4>

            <p><strong>Institute Name:</strong> @Model.InstituteName</p>
            <p><strong>Institute Code:</strong> @Model.InstituteCode</p>
            <p><strong>DISE Code:</strong> @Model.DISECode</p>
            <p><strong>State:</strong> @Model.State</p>
            <p><strong>District:</strong> @Model.District</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Institute Type:</strong> @Model.InstituteType</p>
            <p><strong>Year Admission Started:</strong> @Model.YearAdmissionStarted</p>
            <p><strong>Address:</strong> @Model.Address</p>

            <hr />

            <h4 class="text-secondary fw-bold mb-3">Affiliation Details</h4>

            <p><strong>University State:</strong> @Model.AffiliatedUniversityState</p>
            <p><strong>University Board:</strong> @Model.UniversityBoardName</p>
            <p><strong>Establishment Certificate:</strong> @Model.EstablishmentCertificate</p>
            <p><strong>Affiliation Certificate:</strong> @Model.AffiliationCertificate</p>

            <hr />

            <h4 class="text-secondary fw-bold mb-3">Principal & Contact Info</h4>

            <p><strong>Principal Name:</strong> @Model.PrincipalName</p>
            <p><strong>Mobile Number:</strong> @Model.MobileNumber</p>
            <p><strong>Telephone:</strong> @Model.Telephone</p>

        </div>

        <div class="mt-4">
            <a href="/Institute/Dashboard" class="btn btn-primary px-4 py-2">Back to Dashboard</a>
        </div>

    </div>
</div>
